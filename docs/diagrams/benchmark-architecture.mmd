flowchart LR
    subgraph BenchmarkHarness["Benchmarking Framework"]
        CFG["BenchmarkConfig<br/>(concurrency: 1..64 threads, iterations: 100k)"]
        WORKER["Worker Threads<br/>(Simulating concurrent client workloads)"]
        METRICS["Latency & Throughput Collector<br/>(p50, p95, p99, TPS, QPS)"]
    end

    subgraph TargetWorkloads["Workload Profiles"]
        W1["Point Read Benchmark<br/>(IndexScan on primary key)"]
