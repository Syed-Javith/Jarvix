        W3["ACID Insert/Update Throughput<br/>(Strict 2PL + WAL Group Commit)"]
        W4["Contention Benchmark<br/>(Hot-spot row locking)"]
    end

    subgraph JarvixKernel["Jarvix Database Engine Under Test"]
        SRV["JarvixServer / In-Process Engine"]
        BPM["BufferPoolManager (64..4096 frames)"]
        WAL["WalManager (Group Commit Sync)"]
    end

    CFG --> WORKER
    WORKER --> TargetWorkloads
    TargetWorkloads --> SRV
    SRV --> BPM
    SRV --> WAL
